{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "test/phase1-*.test.ts",
    "test/phase2-*.test.ts",
    "test/phase3-*.test.ts",
    "test/phase4-*.test.ts",
    "test/phase5-*.test.ts",
    "test/phase6-*.test.ts",
    "test/phase7-*.test.ts",
    "test/config.test.ts",
    "test/helpers/**/*.ts",
    "vitest.config.ts"
  ]
}
