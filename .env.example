# Copy this file to services/api/.env and replace every placeholder locally.
# Never commit the resulting .env file.
NODE_ENV=development
EGAS_PORT=4004
EGAS_DB_HOST=localhost
EGAS_DB_PORT=5432
EGAS_DB_NAME=egas_workflow_dev
EGAS_DB_USER=egas_app
EGAS_DB_PASSWORD=<runtime-app-role-password>
EGAS_DB_SSL=false
EGAS_DB_SSL_REJECT_UNAUTHORIZED=true

# Bootstrap values are used only by `npm run admin:bootstrap`.
EGAS_BOOTSTRAP_ADMIN_USERNAME=<temporary-admin-username>
EGAS_BOOTSTRAP_ADMIN_DISPLAY_NAME=<temporary-admin-display-name>
EGAS_BOOTSTRAP_ADMIN_STAFF_IDENTIFIER=<optional-staff-identifier>
EGAS_BOOTSTRAP_ADMIN_JOB_TITLE=<optional-job-title>
EGAS_BOOTSTRAP_ADMIN_TEMP_PASSWORD=<temporary-password-minimum-14-characters>

# Server/session policy. Generate a unique fingerprint secret; do not reuse a password.
EGAS_SESSION_COOKIE_NAME=EGAS_SESSION
EGAS_SESSION_IDLE_MINUTES=30
EGAS_SESSION_ABSOLUTE_HOURS=8
EGAS_REQUIRE_SECURE_COOKIE=false
EGAS_AUTH_FINGERPRINT_SECRET=<random-secret-minimum-32-characters>
EGAS_LOGIN_WINDOW_MINUTES=10
EGAS_LOGIN_FAILURE_LIMIT=5
EGAS_LOGIN_LOCKOUT_MINUTES=15
# Additional trusted Origin values for server-side origin validation. This does not enable CORS;
# browser frontends should use the same origin or a same-origin development proxy.
EGAS_ALLOWED_ORIGINS=

# Private server-side signature storage. Never place this directory under a public web root.
EGAS_SIGNATURE_STORAGE_DIR=storage/signatures
EGAS_SIGNATURE_MAX_UPLOAD_BYTES=1048576
EGAS_SIGNATURE_MAX_WIDTH_PIXELS=2048
EGAS_SIGNATURE_MAX_HEIGHT_PIXELS=2048
EGAS_SIGNATURE_MAX_PIXELS=4000000

# Private frozen-document storage and bounded renderer policy.
EGAS_PDF_STORAGE_DIR=storage/generated-pdfs
EGAS_PDF_MAX_CONCURRENT_RENDERS=2
EGAS_PDF_MAX_QUEUED_RENDERS=20
EGAS_PDF_RENDER_TIMEOUT_MS=15000
EGAS_PDF_MAX_OUTPUT_BYTES=20971520

# Optional pilot/preflight expectation.
EGAS_ACTIVE_SNAPSHOT_YEAR=<YYYY>

# Required only when an approved annual workbook after 2026 uses a new exact header.
EGAS_IMPORT_PERFORMANCE_HEADER=<exact-approved-performance-header>
