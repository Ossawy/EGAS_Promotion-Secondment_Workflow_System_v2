{
  "name": "egas-promotion-secondment-system",
  "version": "1.0.0",
  "private": true,
  "description": "EGAS Promotion & Secondment Workflow System monorepo",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "setup": "npm --workspace @egas/cap-api run setup",
    "dev": "npm --workspace @egas/cap-api run dev",
    "pilot": "npm --workspace @egas/cap-api run pilot",
    "start": "npm --workspace @egas/cap-api run start",
    "build": "npm --workspace @egas/cap-api run build",
    "typecheck": "npm --workspace @egas/cap-api run typecheck",
    "lint": "npm --workspace @egas/cap-api run lint",
    "test": "npm --workspace @egas/cap-api run test",
    "db:migrate": "npm --workspace @egas/cap-api run db:migrate",
    "db:deploy": "npm --workspace @egas/cap-api run db:deploy",
    "admin:bootstrap": "npm --workspace @egas/cap-api run admin:bootstrap",
    "data:import": "npm --workspace @egas/cap-api run data:import --",
    "pilot:check": "npm --workspace @egas/cap-api run pilot:check",
    "security:secrets": "npm --workspace @egas/cap-api run security:secrets",
    "security:scan": "npm --workspace @egas/cap-api run security:scan",
    "security:check": "npm --workspace @egas/cap-api run security:check"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
