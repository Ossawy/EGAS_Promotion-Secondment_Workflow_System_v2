{
  "name": "egas-promotion-secondment-system",
  "version": "1.0.0",
  "private": true,
  "description": "EGAS Promotion & Secondment Workflow System monorepo",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "setup": "npm --workspace @egas/api run setup",
    "dev": "npm --workspace @egas/api run dev",
    "dev:web": "npm --workspace @egas/web run dev",
    "dev:setup": "npm --workspace @egas/api run dev:setup",
    "dev:migrate": "npm --workspace @egas/api run dev:migrate",
    "dev:seed": "npm --workspace @egas/api run dev:seed",
    "dev:check": "npm --workspace @egas/api run dev:check",
    "dev:all": "npm --workspace @egas/api run dev:all",
    "pilot": "npm --workspace @egas/api run pilot",
    "start": "npm --workspace @egas/api run start",
    "build": "npm --workspace @egas/api run build && npm --workspace @egas/web run build",
    "typecheck": "npm --workspace @egas/api run typecheck && npm --workspace @egas/web run typecheck",
    "lint": "npm --workspace @egas/api run lint && npm --workspace @egas/web run typecheck",
    "test": "npm --workspace @egas/api run test && npm --workspace @egas/web run test",
    "db:migrate": "npm --workspace @egas/api run db:migrate",
    "admin:bootstrap": "npm --workspace @egas/api run admin:bootstrap",
    "data:import": "npm --workspace @egas/api run data:import --",
    "data:revalidate": "npm --workspace @egas/api run data:revalidate --",
    "data:activate": "npm --workspace @egas/api run data:activate --",
    "pilot:check": "npm --workspace @egas/api run pilot:check",
    "security:secrets": "npm --workspace @egas/api run security:secrets",
    "security:scan": "npm --workspace @egas/api run security:scan",
    "security:check": "npm --workspace @egas/api run security:secrets && npm --workspace @egas/api run security:scan && npm test"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
