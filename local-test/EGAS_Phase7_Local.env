# EGAS Phase 7 local synthetic sandbox
# Copy to: services/api/.env
# DO NOT COMMIT. This file is intentionally for local synthetic testing only.

NODE_ENV=development
EGAS_PORT=4004

# PostgreSQL local sandbox — runtime role
EGAS_DB_HOST=127.0.0.1
EGAS_DB_PORT=5432
EGAS_DB_NAME=egas_workflow_phase7_local
EGAS_DB_USER=egas_phase7_app
EGAS_DB_PASSWORD=RWaa-ZIQjRfMJHsFDzBfeREomV8GXvIB
EGAS_DB_SSL=false
EGAS_DB_SSL_REJECT_UNAUTHORIZED=true

# Session/auth policy
EGAS_SESSION_COOKIE_NAME=EGAS_PHASE7_LOCAL
EGAS_SESSION_IDLE_MINUTES=30
EGAS_SESSION_ABSOLUTE_HOURS=8
EGAS_REQUIRE_SECURE_COOKIE=false
EGAS_AUTH_FINGERPRINT_SECRET=RZavBLCvL5bTEkBOnhynmU5ideevHsy6fXe7E_JdbZmvaC_UR8EVNVpx1YkHyjkz
EGAS_LOGIN_WINDOW_MINUTES=10
EGAS_LOGIN_FAILURE_LIMIT=5
EGAS_LOGIN_LOCKOUT_MINUTES=15
EGAS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Private local signature storage
EGAS_SIGNATURE_STORAGE_DIR=storage/phase7-local/signatures
EGAS_SIGNATURE_MAX_UPLOAD_BYTES=1048576
EGAS_SIGNATURE_MAX_WIDTH_PIXELS=2048
EGAS_SIGNATURE_MAX_HEIGHT_PIXELS=2048
EGAS_SIGNATURE_MAX_PIXELS=4000000

# Private local PDF storage
EGAS_PDF_STORAGE_DIR=storage/phase7-local/generated-pdfs
EGAS_PDF_MAX_CONCURRENT_RENDERS=2
EGAS_PDF_MAX_QUEUED_RENDERS=20
EGAS_PDF_RENDER_TIMEOUT_MS=15000
EGAS_PDF_MAX_OUTPUT_BYTES=20971520

# Synthetic annual snapshot expected by local smoke tests
EGAS_ACTIVE_SNAPSHOT_YEAR=2026
EGAS_IMPORT_PERFORMANCE_HEADER=تقرير كفاية 2026

# Bootstrap-admin variables are deliberately omitted.
# The synthetic sandbox seed inserts admin.local directly into the CURRENT v5 schema.
